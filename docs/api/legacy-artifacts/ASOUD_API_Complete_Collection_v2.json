			"name": "🔐 Authentication (2 APIs)",
			"item": [
				{
					"name": "Send PIN Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobile_number\": \"09123456789\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/user/pin/create/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "user", "pin", "create", ""]
						},
						"description": "Send SMS verification code to user's mobile number"
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success field\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData.success).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Verify PIN Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobile_number\": \"09123456789\",\n    \"pin\": \"1234\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/user/pin/verify/",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "user", "pin", "verify", ""]
						},
						"description": "Verify SMS PIN code and get authentication token"
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has token\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('data');",
									"    pm.expect(jsonData.data).to.have.property('token');",
									"    ",
									"    // Save token to environment",
									"    pm.environment.set('auth_token', jsonData.data.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			],
			"description": "Authentication endpoints for user login and token management"
		},
